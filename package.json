{
  "name": "lte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@file-viewer/pptx": "^2.2.4",
    "@rareminds-eym/auth-client": "1.0.12",
    "@rareminds-eym/auth-core": "2.1.2",
    "@supabase/supabase-js": "2.110.2",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.101.2",
    "docx-preview": "^0.4.0",
    "framer-motion": "^12.42.2",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.1.1",
    "react-hot-toast": "2.6.0",
    "react-router-dom": "7.18.1",
    "tailwind-merge": "^3.6.0",
    "wrangler": "4.110.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "scripts": {
    "start": "npm run build:dev && concurrently -n \"workers,pages\" -c \"yellow,magenta\" \"npm run workers:dev\" \"npm run pages:dev\"",
    "dev:local": "vite --mode development --port 8789",
    "dev": "vite --mode development --port 8080",
    "dev:prod": "vite --port 8789",
    "build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "build:dev": "node --max-old-space-size=12288 ./node_modules/vite/bin/vite.js build --mode development",
    "lint": "eslint . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:files": "node scripts/checks/validate-file-types.js",
    "lint:console": "node scripts/checks/detect-console-usage.js",
    "lint:lengths": "node scripts/checks/validate-file-lengths.js",
    "lint:auth": "node scripts/checks/validate-auth-calls.js",
    "lint:fsd": "node scripts/checks/validate-fsd-boundaries.js",
    "lint:runtime": "node scripts/checks/validate-runtime-separation.js",
    "lint:apiclient": "node scripts/checks/validate-api-client.js",
    "lint:image": "node scripts/checks/validate-image-components.js",
    "lint:tokens": "node scripts/checks/validate-design-tokens.js",
    "lint:state": "node scripts/checks/validate-state-boundaries.js",
    "lint:catch": "node scripts/checks/validate-empty-catch.js",
    "lint:naming": "node scripts/checks/validate-naming-conventions.js",
    "lint:versioning": "node scripts/checks/validate-endpoint-versioning.js",
    "lint:lazy": "node scripts/checks/validate-route-lazy.js",
    "lint:testlayout": "node scripts/checks/validate-test-layout.js",
    "lint:toaster": "node scripts/checks/validate-toaster-placement.js",
    "lint:binding": "node scripts/checks/validate-service-binding.js",
    "lint:zod": "node scripts/checks/validate-zod-boundaries.js",
    "lint:alias": "node scripts/checks/validate-import-aliases.js",
    "lint:biome": "biome check --reporter=concise .",
    "format:biome": "biome check --write .",
    "lint:secrets": "secretlint \"src/**/*\" \"functions/**/*\"",
    "preview": "vite preview",
    "test:dev": "npm run lint && npm run lint:files && npm run lint:console && npm run lint:lengths && npm run lint:auth && npm run lint:fsd && npm run lint:runtime && npm run lint:apiclient && npm run lint:image && npm run lint:tokens && npm run lint:state && npm run lint:catch && npm run lint:naming && npm run lint:versioning && npm run lint:lazy && npm run lint:testlayout && npm run lint:toaster && npm run lint:binding && npm run lint:zod && npm run lint:alias && npm run lint:biome && npm run lint:secrets", 
    "test": "vitest",
    "test:ci": "vitest run",
    "eval:replay": "esbuild scripts/eval-replay.ts --bundle --platform=node --outfile=/tmp/eval-replay.js && node /tmp/eval-replay.js",
    "db:reset:dev": "supabase db reset --sql-paths \"./seed/dev/*.sql\"",
    "db:reset:prod": "supabase db reset --sql-paths \"./seed/production/*.sql\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "setup:husky": "node scripts/tools/setup-husky-cross-platform.js",
    "ci": "npm run lint:files && npm run lint:console && npm run lint:lengths && npm run lint:biome && npm run lint:secrets && npm run lint && npm run typecheck && vitest run",
    "workers:dev": "npm run workers:sso",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-06-08 --port=8789 --service SSO_SERVICE=sso-api",
    "pages:build": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "9.27.0",
    "@secretlint/quick-start": "11.4.0",
    "@secretlint/secretlint-rule-preset-recommend": "11.4.0",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/ui": "4.1.10",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jsdom": "29.0.1",
    "lint-staged": "16.4.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.1",
    "stylelint": "17.5.0",
    "stylelint-config-standard": "40.0.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "8.1.5",
    "vite-plugin-svgr": "4.5.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.0"
  }
}
