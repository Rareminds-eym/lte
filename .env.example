# Vite Frontend Environment Variables Template for LTE
# Copy this file to .env for local development

# SkillPassport SSO Landing Page URL (Required)
VITE_SKILLPASSPORT_URL=http://127.0.0.1:8788

# Graphify - Knowledge Graph (optional, for semantic extraction of docs/images)
# Set one of these to enable full extraction (AST-only mode works without keys):
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=
#
# Supabase (required for local backend functions)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# On first clone, run: graphify hook install
# to set up auto-rebuild (post-commit/post-checkout) and the graph.json merge driver.
