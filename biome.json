{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**/*.js",
      "src/**/*.ts",
      "src/**/*.tsx",
      "functions/**/*.ts",
      "test/**/*.js",
      "test/**/*.ts",
      "!**/*.min.js"
    ]
  },
  "linter": {
    "enabled": true,
    "includes": ["**", "!test/**"],
    "rules": {
      "a11y": {
        "useButtonType": "warn"
      },
      "complexity": {
        "noCommaOperator": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
