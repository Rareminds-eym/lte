#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Validate file types (TypeScript only)
echo "📋 Validating file types..."
npm run lint:files
if [ $? -ne 0 ]; then
  echo "❌ File type validation failed!"
  exit 1
fi

# Check for console statements
echo "✓ File types valid. Checking for console usage..."
npm run lint:console
if [ $? -ne 0 ]; then
  echo "⚠️  Console statements found (review before commit)"
fi

# Run Biome format and lint check
echo "✓ Running Biome format and lint checks..."
npx biome check --apply
if [ $? -ne 0 ]; then
  echo "❌ Biome checks failed!"
  exit 1
fi

# Run ESLint
echo "✓ Biome checks passed. Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed!"
  exit 1
fi

# Type check
echo "✓ ESLint passed. Running TypeScript type check..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type check failed!"
  exit 1
fi

echo "✅ All pre-commit checks passed!"
