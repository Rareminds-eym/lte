{
  "$schema": "https://unpkg.com/knip@5/schema.json",
 "entry": [
  "src/entities/*/index.ts",
  "src/features/*/index.ts",
  "src/widgets/*/index.ts",
  "src/pages/*/index.ts",
  "src/shared/**/index.ts",
  "functions/api/**/*.ts",
  "functions/lib/*.ts",
  "functions/lib/**/index.ts",
  "functions/shared/*.ts",
  "functions/schemas/*.ts"
],
  "project": [
    "src/**/*.{ts,tsx}",
    "functions/**/*.ts"
  ],

  "ignoreExportsUsedInFile": true,
  "ignore": [
    "src/__tests__/**/*",
    "functions/**/__tests__/**/*",
    "vite.config.ts",
    "eslint.config.js",
    "postcss.config.js",
    "commitlint.config.js",
    "tailwind.config.ts"
  ],
  "ignoreBinaries": [
    "secretlint",
    "esbuild",
    "concurrently"
  ],

  "ignoreDependencies": [
    "wrangler",
    "concurrently",
    "esbuild",
    "@secretlint/quick-start",
    "@secretlint/secretlint-rule-preset-recommend",
    "husky",
    "lint-staged",
    "npm-run-all",
    "@tailwindcss/postcss",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint-config-prettier",
    "eslint-plugin-prettier",
    "steiger",
    "@feature-sliced/steiger-plugin"
  ]
}